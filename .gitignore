# ============================================================
# 数据文件：体积大(约 70MB)，且 Kaggle 竞赛数据不宜公开再分发
# 复现方式见 docs/项目说明.md —— 从 Kaggle 竞赛页自行下载
# ============================================================
train.csv
test.csv
sample_submission.csv
data/raw/*.csv
data/interim/
data/processed/

# ============================================================
# output/ 默认整个忽略：中间产物动辄几十 MB，且全部可由脚本确定性重建。
# 只有两个冻结常量例外 —— 它们是全组分数可比的基础，必须进 git。
# ============================================================
output/*
!output/folds.rds
!output/subsample_200k.rds

# 提交文件本体不进 git，但 submissions/log.csv（分数台账）要进
submissions/*.csv
!submissions/log.csv

# ============================================================
# R / RStudio
# ============================================================
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj.bak

# renv：锁文件必须进 git（复现的关键），库本体不进
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# ============================================================
# 渲染中间产物
# ============================================================
*_files/
*_cache/
/.quarto/
reports/*.html
reports/*.pdf

# ============================================================
# 系统
# ============================================================
Thumbs.db
Desktop.ini
.DS_Store
